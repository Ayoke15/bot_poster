# Copy to .env for Compose; supply real values securely. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# URL-encode special characters in the password. Host 'db' is for Compose.
DATABASE_URL=postgresql://postgres:replace-with-a-long-random-password@db:5432/tg_vk
APP_BASE_URL=https://your-public-domain.example
TELEGRAM_BOT_TOKEN=
# 16–256 letters, digits, underscores or hyphens.
TELEGRAM_WEBHOOK_SECRET=
# Base64 encoding of 32 random bytes. Generate once: openssl rand -base64 32
# Keep a secure backup; changing this key makes existing tokens unreadable.
TOKEN_ENCRYPTION_KEY=
VK_API_VERSION=5.199
LISTEN_ADDR=:8000
